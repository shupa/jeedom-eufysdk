+/**
+ * Standalone (self-station) Wall Light Cam device types — units that are their own station
+ * (`homeBaseAttached === false`) rather than hanging off a separate HomeBase.
+ *
+ * UNVERIFIED on real hardware as of this patch, revision 2. Revision 1 routed this through
+ * {@link cameraAlarm} (`CAMERA_TONE`/1202, int-plus-string) and got `ok:true` from the bridge with
+ * no audible effect on a real T84A1 — the wrong wire, not a dead end: `eufy-security-client`'s own
+ * `Station.triggerStationAlarmSound` treats a self-station device as A STATION triggering ITS OWN
+ * alarm (`CMD_SET_TONE_FILE`/1201), not as a hub relaying to a different device (1202). Its
+ * `isIntegratedDeviceBySn` allowlist (explicitly marked `TODO: Update this implementation!` there)
+ * does not yet include the T84A1 prefix, so on reasonably current firmware that function takes the
+ * `SET_PAYLOAD`-wrapped branch — exactly {@link homeBaseAlarm}'s wire, already implemented and used
+ * by {@link isEvidencedStationAlarm} below. Routing here through "homebase" is therefore not a new
+ * wire, only a new condition admitting it. If this, too, has no audible effect, the next candidate
+ * is the OTHER `triggerStationAlarmSound` branch (`CMD_SET_TONE_FILE`, int-plus-string, `value: 2`,
+ * `valueSub: seconds`) — taken for firmware older than 2.0.7.9 or once Anker extends
+ * `isIntegratedDeviceBySn` to this prefix.
+ */
+function isSelfStationWallLightCam(ctx: CommandContext): boolean {
+  return (
+    ctx.codec === "camera" &&
+    ctx.homeBaseAttached === false &&
+    (ctx.deviceType === DeviceType.WALL_LIGHT_CAM || ctx.deviceType === DeviceType.WALL_LIGHT_CAM_81A0)
+  );
+}
