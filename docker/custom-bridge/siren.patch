+/**
+ * Standalone (self-station) Wall Light Cam device types — units that are their own station
+ * (`homeBaseAttached === false`) rather than hanging off a separate HomeBase.
+ *
+ * UNVERIFIED on real hardware as of this patch, revision 3.
+ * - Revision 1 routed this through {@link cameraAlarm} (`CAMERA_TONE`/1202, level-1 int-plus-string,
+ *   `ctx.channel`). Live test: `ok:true`, no sound — wrong command id/channel for this family.
+ * - Revision 2 routed it through {@link homeBaseAlarm} (`HOMEBASE_TONE`/1201, level-2 `SET_PAYLOAD`).
+ *   Live test: `StationKeyUnavailableError` — this device's P2P session never completes a level-2
+ *   key handshake for itself, so ANY level-2 command dies here regardless of its payload.
+ * - Revision 3 (this one): `eufy-security-client`'s `Station.triggerStationAlarmSound` has a THIRD
+ *   wire, taken for firmware older than 2.0.7.9 or a device on its `isIntegratedDeviceBySn`
+ *   allowlist (which doesn't list the T84A1 prefix yet, hence revision 2's guess that firmware
+ *   gating would pick the other branch — wrong on this unit): `CMD_SET_TONE_FILE`/1201 sent as a
+ *   level-1 **int-plus-string** frame (`value: 2`, `valueSub: seconds`, channel `Station.CHANNEL`),
+ *   the same transport kind as revision 1 (no key wait) but the right command id and value mapping.
+ *   Built by {@link integratedStationAlarm} below, since neither {@link cameraAlarm} nor
+ *   {@link homeBaseAlarm} matches this exact wire.
+ */
+function isSelfStationWallLightCam(ctx: CommandContext): boolean {
+  return (
+    ctx.codec === "camera" &&
+    ctx.homeBaseAttached === false &&
+    (ctx.deviceType === DeviceType.WALL_LIGHT_CAM || ctx.deviceType === DeviceType.WALL_LIGHT_CAM_81A0)
+  );
+}
+
+/**
+ * The "integrated device" branch of `eufy-security-client`'s `triggerStationAlarmSound`: a level-1
+ * int-plus-string frame on `CMD_SET_TONE_FILE` (the same command id as {@link homeBaseAlarm}, but a
+ * different wire shape — no level-2 key required). `value: 2` is a fixed selector this branch always
+ * sends (not a duration); `seconds` travels in `valueSub`. A duration of `0` stops a sounding alarm,
+ * mirroring `resetStationAlarmSound()` (`triggerStationAlarmSound(0)`).
+ */
+function integratedStationAlarm(seconds: number): Command {
+  return {
+    kind: "p2p-int-string",
+    cmd: SIREN_CMD.HOMEBASE_TONE,
+    value: 2,
+    valueSub: seconds,
+    channel: STATION_CHANNEL,
+  };
+}
