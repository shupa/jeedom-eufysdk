+/**
+ * Standalone (self-station) Wall Light Cam device types — units that are their own station
+ * (`homeBaseAttached === false`) rather than hanging off a separate HomeBase.
+ *
+ * UNVERIFIED on real hardware as of this patch. `eufy-security-client`'s own command table lists
+ * `DeviceTriggerAlarmSound` / `StationTriggerAlarmSound` for both device types below, and the wire
+ * it sends (`CMD_SET_DEVS_TONE_FILE` / 1202, an int+sub-value P2P frame to the device's own
+ * channel) is exactly {@link SIREN_CMD.CAMERA_TONE}'s plain (non-S1-Pro) form — the same one an
+ * attached camera already uses. This repo's own evidence model just never had a case for "the
+ * camera is its own station", so the capability never surfaced. No param evidence is known for
+ * this family yet (nothing has been captured proving the device reports anything before it will
+ * accept the command), so this gates on device-type identity alone. If a live test against a real
+ * unit shows no sound (or an error), drop this function, its two call sites below, and the
+ * `selfStationWallLight` branch in `detection.detect`.
+ */
+function isSelfStationWallLightCam(ctx: CommandContext): boolean {
+  return (
+    ctx.codec === "camera" &&
+    ctx.homeBaseAttached === false &&
+    (ctx.deviceType === DeviceType.WALL_LIGHT_CAM || ctx.deviceType === DeviceType.WALL_LIGHT_CAM_81A0)
+  );
+}
