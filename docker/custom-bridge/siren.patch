+/**
+ * Standalone (self-station) Wall Light Cam device types — units that are their own station
+ * (`homeBaseAttached === false`) rather than hanging off a separate HomeBase.
+ *
+ * WIRE-CONFIRMED on real hardware (T84A1), revision 4 — reverse-engineered from a packet capture of
+ * the official app's own trigger/stop, decrypted with the session's level-1 AES-128-ECB key:
+ * - Revision 1 routed this through {@link cameraAlarm} (`CAMERA_TONE`/1202, level-1 int-plus-string,
+ *   `ctx.channel`). Live test: `ok:true`, no sound — wrong command id/channel for this family.
+ * - Revision 2 routed it through {@link homeBaseAlarm} (`HOMEBASE_TONE`/1201, level-2 `SET_PAYLOAD`).
+ *   Live test: `StationKeyUnavailableError` — this device's P2P session never completes a level-2
+ *   key handshake for itself, so ANY level-2 command dies here regardless of its payload.
+ * - Revision 3 guessed `eufy-security-client`'s "integrated device" int-string branch verbatim
+ *   (`value: 2`, `valueSub: seconds`, channel `Station.CHANNEL`/255). Live test: `ok:true`, no sound
+ *   — same command id as the real wire, but the wrong field mapping and the wrong channel.
+ * - Revision 4 (this one) replays the captured real wire exactly: `CMD_SET_TONE_FILE`/1201, level-1
+ *   int-plus-string, **`channel: 0`** (not 255), `value` = duration in seconds (`30` on the captured
+ *   trigger, `0` on the captured stop — `0` reads naturally as "no duration" for a stop), and a fixed
+ *   `valueSub` the capture shows differs between trigger (`23`) and stop (`4`) — evidently a sub-action
+ *   selector, not something derived from the duration, so it is reproduced as a literal constant
+ *   rather than guessed at. No `strValue` was present (zero-padded). Live test: confirmed audible.
+ */
+function isSelfStationWallLightCam(ctx: CommandContext): boolean {
+  return (
+    ctx.codec === "camera" &&
+    ctx.homeBaseAttached === false &&
+    (ctx.deviceType === DeviceType.WALL_LIGHT_CAM || ctx.deviceType === DeviceType.WALL_LIGHT_CAM_81A0)
+  );
+}
+
+/** Sub-action selector the real app sends in `valueSub` alongside {@link SIREN_CMD.HOMEBASE_TONE} on a
+ * self-station Wall Light Cam — wire-captured, not derived from the duration (see
+ * {@link isSelfStationWallLightCam}'s doc comment for how these were recovered). */
+const SELF_STATION_TONE_SUB = { trigger: 23, stop: 4 } as const;
+
+/**
+ * The real self-station Wall Light Cam wire for `CMD_SET_TONE_FILE`/1201, recovered from a packet
+ * capture of the official app (see {@link isSelfStationWallLightCam}'s doc comment): level-1
+ * int-plus-string, `channel: 0`, `value` = duration in seconds (`0` to stop), `valueSub` a fixed
+ * sub-action selector that differs between trigger and stop.
+ */
+function integratedStationAlarm(seconds: number): Command {
+  return {
+    kind: "p2p-int-string",
+    cmd: SIREN_CMD.HOMEBASE_TONE,
+    value: seconds,
+    valueSub: seconds === 0 ? SELF_STATION_TONE_SUB.stop : SELF_STATION_TONE_SUB.trigger,
+    channel: 0,
+  };
+}
